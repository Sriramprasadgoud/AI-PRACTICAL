def bfs(start, goal):
    to_do = [start]
    visited = []
    order = []
    while to_do:
        room = to_do.pop(0)
        if room in visited:
            continue
        visited.append(room)
        order.append(room)
        if room == goal:
            return order
        for nxt in map_rooms[room]:
            to_do.append(nxt)
    return order

order_bfs = bfs("A", "G")
print("BFS checked the rooms in this order:", order_bfs)
print("Number of rooms BFS checked:", len(order_bfs))
